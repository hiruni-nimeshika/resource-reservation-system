// Paste this into https://dbdiagram.io/d to get a shareable ER diagram link.

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  email text [not null, unique, note: 'unique on lower(email)']
  password_hash text [not null, note: 'scrypt']
  role text [not null, default: 'member', note: "'admin' | 'member'"]
  created_at timestamptz [not null, default: `now()`]
}

Table sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  token_hash text [not null, unique, note: 'SHA-256 of the cookie token']
  user_id uuid [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null, unique]
  description text
}

Table resources {
  id uuid [pk, default: `gen_random_uuid()`]
  category_id uuid [not null]
  name text [not null, unique]
  description text
  location text
  capacity int [note: 'optional, must be > 0']
  is_active boolean [not null, default: true, note: 'false = retired (history kept)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table reservations {
  id uuid [pk, default: `gen_random_uuid()`]
  resource_id uuid [not null]
  user_id uuid [not null]
  title text [not null]
  notes text
  start_time timestamptz [not null]
  end_time timestamptz [not null, note: 'CHECK (end_time > start_time)']
  status text [not null, default: 'confirmed', note: "'confirmed' | 'cancelled'"]
  cancelled_at timestamptz
  cancelled_by uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (resource_id, start_time)
    (user_id, start_time)
  }
  Note: 'EXCLUDE USING gist (resource_id WITH =, tstzrange(start_time, end_time, [)) WITH &&) WHERE status = confirmed -> no double booking'
}

Ref: sessions.user_id > users.id [delete: cascade]
Ref: resources.category_id > categories.id [delete: restrict]
Ref: reservations.resource_id > resources.id [delete: restrict]
Ref: reservations.user_id > users.id [delete: restrict]
Ref: reservations.cancelled_by > users.id [delete: set null]
