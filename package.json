{
  "name": "resource-reservation",
  "version": "1.0.0",
  "private": true,
  "description": "Resource Reservation Management System - PrimeWave Lab technical assessment",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
